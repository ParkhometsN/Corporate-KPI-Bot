ENVIRONMENT=production
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

BOT_TOKEN=put_telegram_bot_token_here
ADMIN_PASSWORD=change_this_password

DATABASE_URL=postgresql+asyncpg://kpi_bot:change_this_password@postgres:5432/kpi_bot
POSTGRES_DB=kpi_bot
POSTGRES_USER=kpi_bot
POSTGRES_PASSWORD=change_this_password

REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=generate_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ENCRYPTION_KEY=generate_fernet_key

YCLIENTS_BASE_URL=https://api.yclients.com/api/v1
YCLIENTS_PARTNER_TOKEN=put_yclients_api_key_here
YCLIENTS_USER_TOKEN=
YCLIENTS_PARTNER_ID=8240
YCLIENTS_DEFAULT_COMPANY_ID=1444327
YCLIENTS_TIMEOUT_SECONDS=30

DEFAULT_COMPANY_TITLE=Барбершоп
LOW_STOCK_THRESHOLD=3
CONNECTION_CODE_TTL_MINUTES=15
SYNC_INTERVAL_MINUTES=60
DAILY_REPORT_CRON="0 10 * * *"
WEEKLY_REPORT_CRON="0 11 * * MON"
MONTHLY_REPORT_CRON="0 12 1 * *"

INTERNAL_API_ENABLED=true
INTERNAL_API_HOST=0.0.0.0
INTERNAL_API_PORT=8080
